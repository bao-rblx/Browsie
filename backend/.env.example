# Copy to backend/.env and fill in. backend/.env is git-ignored.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# gemini | mock  (defaults to mock when GEMINI_API_KEY is empty)
LLM_PROVIDER=
LLM_TIMEOUT_S=8
DATABASE_URL=sqlite:///./browsie.db
# Shared token the extension sends as X-Browsie-Token. Empty = no auth (local dev only!)
BROWSIE_API_TOKEN=
RATE_LIMIT_PER_MIN=60
MAX_TEXT_CHARS=8000
MAX_IMAGE_BYTES=5242880
